[Unit]
Description=GBC Server unified Web API and plugin listeners
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gbcserver
Group=gbcserver
WorkingDirectory=/var/lib/gbcserver
ExecStart=/usr/bin/gbcserver start --data-dir /var/lib/gbcserver
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/gbcserver

[Install]
WantedBy=multi-user.target
